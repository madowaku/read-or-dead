{
  "name": "read-or-dead",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "preview": "vite preview --host",
    "deploy": "npm run build && cf deploy --prebuilt --mode production",
    "test": "vitest run",
    "types": "cf workers types",
    "typecheck": "cf workers types && tsc --noEmit && tsc --noEmit -p worker"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.0",
    "@types/node": "^22.20.5",
    "cf": "^1.0.0-beta.24",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "mediabunny": "^1.62.1"
  }
}
